rules_version = '2';

// ============================================================================
// 전산 요청 관리 시스템 — Firestore 보안 규칙 (Firebase Authentication 적용)
//
// 로그인: 이메일/비밀번호. 화면에는 "연락처 + 비밀번호"만 보이고 내부 이메일은
//     <연락처>_<랜덤>@jjangkait001.firebaseapp.com   (일반 직원: 첫 설정·초기화·신규 등록)
//     <연락처>@jjangkait001.firebaseapp.com          (최고관리자만 — 콘솔에서 미리 만든 계정)
//   members.authEmail = 지금 유효한 로그인 계정. 이 값과 같은 계정만 인정합니다.
//   기존 직원은 authEmail이 없으므로 관리자가 발급한 "첫 설정 코드"로만 계정을 연결할 수 있습니다.
//
// 권한
//   접수(tickets)  읽기: 승인된 사용자
//                  등록: 본인 이름·연락처·지점으로만 (admin은 엑셀 가져오기용으로 제한 없음)
//                  처리상태·답변·지점 변경·삭제: admin, manager / 내용 수정: 작성자 본인(내용 항목만)
//   설정(config)   읽기: 승인된 사용자 / 쓰기: admin
//   회원(members)  읽기: 승인된 사용자 + 본인 / 가입: '승인 대기 + 요청자'로만
//                  승인·권한·지점 변경: admin (로그인 계정은 바꿀 수 없음, 최고관리자 문서는 본인만)
//
// 코드 (resetCodes/{연락처}_{코드}, admin만 읽기)
//   kind 'setup' : 첫 설정 코드, 영문+숫자 8자리, 24시간
//   kind 'reset' : 비밀번호 초기화 코드, 숫자 6자리, 30분
//   사용자는 새 로그인 계정을 만든 뒤 한 번에(batch) members.authEmail 변경 + 코드 삭제 + logins 갱신.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // 최고관리자 연락처 (index.html의 ADMIN_PHONE_DIGITS와 같아야 함)
    function superId() { return '01094820353'; }
    function domain() { return 'jjangkait001.firebaseapp.com'; }

    function signedIn() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.matches('^[0-9]+(_[a-z0-9]+)?@jjangkait001[.]firebaseapp[.]com$');
    }
    function myEmail() { return request.auth.token.email; }
    function myId() { return myEmail().split('@')[0].split('_')[0]; }
    function legacyEmail(id) { return id + '@' + domain(); }
    function memberPath(id) { return /databases/$(database)/documents/members/$(id); }
    function codePath(id) { return /databases/$(database)/documents/resetCodes/$(id); }
    function me() { return get(memberPath(myId())).data; }

    // 회원 정보가 가리키는 로그인 계정인지. authEmail이 없으면 최고관리자만 예전 형식 계정을 인정
    function defaultEmail() { return myId() == superId() ? legacyEmail(superId()) : '-'; }
    function isMyAccount(m) { return m.get('authEmail', defaultEmail()) == myEmail(); }

    function approved()  { return signedIn() && exists(memberPath(myId())) && isMyAccount(me()) && me().status == 'approved'; }
    function isAdmin()   { return approved() && me().role == 'admin'; }
    function canManage() { return approved() && me().role in ['admin', 'manager']; }

    function codeTtl(c) { return c.get('kind', 'reset') == 'setup' ? duration.value(24, 'h') : duration.value(30, 'm'); }
    function validCode(kind, code) {
      return code is string && (
        (kind == 'reset' && code.matches('^[0-9]{6}$'))
        || (kind == 'setup' && code.matches('^[A-HJKMNP-Z2-9]{8}$')));
    }

    // 코드로 회원 정보의 로그인 계정을 새 계정으로 바꾸는 경우
    function resetByCode(memberId) {
      let code = request.resource.data.lastResetCode;
      let cp = codePath(memberId + '_' + code);
      return signedIn() && memberId == myId() && memberId != superId()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['authEmail', 'lastResetCode', 'resetAt'])
        && request.resource.data.authEmail == myEmail()
        && code is string
        && request.resource.data.resetAt == request.time
        && exists(cp)
        && get(cp).data.createdAt + codeTtl(get(cp).data) > request.time
        && !existsAfter(cp);
    }

    // 코드 문서를 사용자가 쓰고 폐기하는 경우 (위 resetByCode와 같은 batch에서만 통과)
    function consumeCode() {
      let after = getAfter(memberPath(myId())).data;
      return signedIn() && myId() != superId()
        && resource.data.phone == myId()
        && resource.data.createdAt + codeTtl(resource.data) > request.time
        && after.get('authEmail', '') == myEmail()
        && after.get('lastResetCode', '') == resource.data.code;
    }

    match /members/{memberId} {
      allow read: if approved() || (signedIn() && memberId == myId());

      allow create: if signedIn() && memberId == myId()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.authEmail == myEmail()
        && (
          (request.resource.data.status == 'pending' && request.resource.data.role == 'requester')
          || (memberId == superId()
              && myEmail() == legacyEmail(memberId)
              && request.resource.data.status == 'approved'
              && request.resource.data.role == 'admin')
        );

      allow update: if (isAdmin()
          && request.resource.data.role in ['admin', 'manager', 'requester']
          && request.resource.data.status in ['pending', 'approved', 'rejected']
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['authEmail', 'lastResetCode', 'resetAt'])
          && (memberId != superId() || memberId == myId()))
        || resetByCode(memberId);

      allow delete: if isAdmin() && memberId != superId();
    }

    // 연락처 → 현재 로그인 계정 이메일 (로그인 화면에서 로그인 전에 1건씩만 조회)
    match /logins/{phone} {
      allow get: if true;
      allow list: if false;
      allow create, update: if signedIn() && phone == myId()
        && request.resource.data.keys().hasOnly(['email'])
        && request.resource.data.email == myEmail()
        && getAfter(memberPath(phone)).data.get('authEmail', '') == myEmail();
      allow delete: if isAdmin() && phone != superId();
    }

    // 비밀번호 초기화 요청 (로그인 없이 등록)
    match /resetRequests/{phone} {
      allow create, update: if phone.matches('^01[0-9]{8,9}$') && phone != superId()
        && request.resource.data.keys().hasOnly(['phone', 'requestedAt'])
        && request.resource.data.phone == phone
        && request.resource.data.requestedAt == request.time;
      allow read, delete: if isAdmin();
    }

    // 첫 설정 코드 / 초기화 코드 (문서 ID = 연락처_코드). admin만 읽을 수 있음
    match /resetCodes/{codeId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['phone', 'code', 'kind', 'createdAt', 'createdBy'])
        && request.resource.data.phone is string
        && request.resource.data.phone != superId()
        && validCode(request.resource.data.kind, request.resource.data.code)
        && codeId == request.resource.data.phone + '_' + request.resource.data.code
        && request.resource.data.createdAt == request.time;
      allow delete: if isAdmin() || consumeCode();
    }

    // 접수 티켓
    function ownTicketOk() {
      let d = request.resource.data;
      let m = me();
      return d.keys().hasAll(['branch', 'requester', 'phone', 'status', 'createdAt'])
        && d.phone == m.phone && d.requester == m.name && d.branch == m.branch
        && d.get('requesterRole', 'requester') == m.get('role', 'requester')
        && d.status == '접수'
        && d.get('answer', '') == '' && d.get('answeredBy', '') == '';
    }
    function ownerEditOk() {
      return approved() && resource.data.phone == me().phone
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['content', 'category', 'menuPath', 'memberName', 'memberNumber', 'type', 'updatedAt']);
    }

    match /tickets/{ticketId} {
      allow read: if approved();
      allow create: if isAdmin() || (approved() && ownTicketOk());
      allow update: if canManage() || ownerEditOk();
      allow delete: if canManage();
    }

    // 분류/유형/지점 등 공통 설정
    match /config/{docId} {
      allow read: if approved();
      allow write: if isAdmin();
    }
  }
}
