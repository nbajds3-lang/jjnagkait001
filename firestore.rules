rules_version = '2';

// ============================================================================
// 전산 요청 관리 시스템 — Firestore 보안 규칙 (초안)
//
// 이 앱은 별도 Firebase Auth 로그인 없이 "지점/이름/전화번호"만으로 접속하는
// 구조라, Firestore 규칙만으로는 "이 요청이 실제로 그 전화번호의 소유자가
// 보낸 것"까지는 검증할 수 없습니다. 최소한 아래를 보장합니다:
//   - members 컬렉션의 role/status 필드는 클라이언트가 직접 바꿀 수 없음
//     (승인/역할변경은 반드시 서버 로직 없이는 불가능하도록 막아야 하지만,
//      Auth가 없는 한 완벽한 차단은 어렵습니다 — 아래 참고 주석 확인)
//   - tickets/config 는 아무나 읽고 쓸 수 없고, 최소한 "읽기"는 제한
//
// ⚠️ 중요: 지금 구조(전화번호 자율 입력)로는 진짜 프로덕션 보안을 100%
// 확보하기 어렵습니다. 정식 오픈 전 Firebase Authentication(전화번호 인증
// 또는 커스텀 토큰)을 붙이는 것을 강하게 권장합니다. 아래 규칙은 "인증 없는
// 상태에서 최소한의 방어선"이며, Auth 도입 전까지의 임시 조치로 봐주세요.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // 회원(멤버) — 승인 대기/거절/역할 정보. 조회는 필요하지만(현재 로그인한
    // 사람이 승인됐는지 확인해야 하므로) 쓰기는 최소화합니다.
    match /members/{memberId} {
      allow read: if true; // 승인 상태 확인을 위해 열람은 허용
      // 최초 가입(pending 상태로 생성)만 허용, 그 외 수정(승인/역할변경)은
      // 관리자 화면에서만 일어나야 하므로 Auth 도입 후 admin 커스텀 클레임
      // 검사로 교체하세요. 지금은 임시로 생성만 열어둡니다.
      allow create: if request.resource.data.status == 'pending';
      allow update, delete: if false; // TODO: Auth 도입 후 admin만 허용으로 교체
    }

    // 분류/유형/지점 등 공통 설정
    match /config/{docId} {
      allow read: if true;
      allow write: if false; // TODO: Auth 도입 후 admin만 허용으로 교체
    }

    // 접수 티켓
    match /tickets/{ticketId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['branch','requester','phone','status','createdAt']);
      allow update, delete: if true; // TODO: Auth 도입 후 작성자 본인 또는 관리자만 허용으로 교체
    }
  }
}
