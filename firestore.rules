rules_version = '2';

// ============================================================================
// 전산 요청 관리 시스템 — Firestore 보안 규칙 (초안)
//
// 이 앱은 별도 Firebase Auth 로그인 없이 "지점/이름/전화번호"만으로 접속하는
// 구조라, Firestore 규칙만으로는 "이 요청이 실제로 그 전화번호의 소유자가
// 보낸 것"까지는 검증할 수 없습니다. 최소한 아래를 보장합니다:
//   - members 신규 가입은 pending 상태로만 생성 가능 (그 외 필드로 바로
//     승인 상태를 만들어 셀프 승인하는 것은 막음)
//   - 승인/거절/차단/권한변경(update)과 분류·유형·지점 설정(config) 저장은
//     지금은 Auth가 없어 "관리자 화면에서만 호출한다"는 프런트엔드 신뢰에
//     의존합니다 — Auth 도입 전까지의 임시 조치이니 참고하세요.
//
// ⚠️ 중요: 지금 구조(전화번호 자율 입력)로는 진짜 프로덕션 보안을 100%
// 확보하기 어렵습니다. 정식 오픈 전 Firebase Authentication(전화번호 인증
// 또는 커스텀 토큰)을 붙이는 것을 강하게 권장합니다. 아래 규칙은 "인증 없는
// 상태에서 최소한의 방어선"이며, Auth 도입 전까지의 임시 조치로 봐주세요.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // 회원(멤버) — 승인 대기/거절/역할 정보. 조회는 필요하지만(현재 로그인한
    // 사람이 승인됐는지 확인해야 하므로) 쓰기는 최소화합니다.
    match /members/{memberId} {
      allow read: if true; // 승인 상태 확인을 위해 열람은 허용
      // 최초 가입(pending 상태로 생성)만 허용. 승인/거절/차단/권한변경은 회원관리
      // 화면(전체관리자·운영관리자)에서 클라이언트가 직접 update()를 호출하는 구조라,
      // 여기를 false로 막아두면 그 기능들이 전부 조용히 실패합니다 —
      // Auth 도입 전까지는 열어두고, 도입 후 admin 커스텀 클레임 검사로 교체하세요.
      allow create: if request.resource.data.status == 'pending';
      allow update, delete: if true; // TODO: Auth 도입 후 admin만 허용으로 교체
    }

    // 분류/유형/지점 등 공통 설정
    match /config/{docId} {
      allow read: if true;
      allow write: if true; // TODO: Auth 도입 후 admin만 허용으로 교체 (지금은 write:false였던 탓에
                             // 기준관리(분류/유형/지점, 지점↔본사 이동 포함) 저장이 전부 막혀 있었음)
    }

    // 접수 티켓
    match /tickets/{ticketId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['branch','requester','phone','status','createdAt']);
      allow update, delete: if true; // TODO: Auth 도입 후 작성자 본인 또는 관리자만 허용으로 교체
    }
  }
}
