rules_version = '2';

// ============================================================================
// 전산 요청 관리 시스템 — Firebase Storage 보안 규칙 (초안)
//
// firestore.rules와 동일한 이유로, 별도 Firebase Auth 없이는 "누가 업로드했는지"
// 완벽히 검증할 수 없습니다. 최소한 아래만 보장합니다:
//   - 첨부파일은 앱이 실제로 쓰는 attachments/ 경로 아래에서만 읽기/쓰기 가능
//   - 파일 크기(10MB)와 형식(이미지/PDF)만 제한
//
// ⚠️ 정식 오픈 후 트래픽이 늘면 Firebase Authentication 도입을 권장합니다.
// ============================================================================

service firebase.storage {
  match /b/{bucket}/o {
    match /attachments/{fileName} {
      allow read: if true;
      allow write: if request.resource.size < 10 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType == 'application/pdf');
      allow delete: if true; // TODO: Auth 도입 후 작성자 본인 또는 관리자만 허용으로 교체
    }
    // 그 외 경로는 기본적으로 차단
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
